{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/jasa/seo-terbaik-se-indonesia",
      "destination": "/seo-terbaik-se-indonesia.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(storage|assets/img)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
